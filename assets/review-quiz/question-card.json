{
  "componentName": "Page",
  "state": {
    "quiz": {
      "no": 1,
      "total": 179,
      "type": "单选题",
      "stem": "下列对文化描述错误的是：",
      "options": [
        { "label": "A", "text": "人类为了生存与理想而进行" },
        { "label": "B", "text": "在物质生产过程中所获得的能力" },
        { "label": "C", "text": "在精神生产过程中所产生的产品" },
        { "label": "D", "text": "只包括精神产品" }
      ]
    },
    "feedback": "",
    "score": { "answered": 0, "correct": 0 },
    "selected": ""
  },
  "methods": {
    "pick": {
      "type": "JSFunction",
      "value": "function pick(value) { if (!value) return; this.callAction('continueChat', { message: '第' + this.state.quiz.no + '题我选 ' + value }); }"
    }
  },
  "children": [
    {
      "componentName": "TinyCard",
      "children": [
        {
          "componentName": "Text",
          "props": {
            "style": "font-size:12px;opacity:.65;display:block;margin-bottom:8px;",
            "text": {
              "type": "JSExpression",
              "value": "'题库模式 · 第 ' + this.state.quiz.no + ' / ' + this.state.quiz.total + ' 题 · 已答 ' + this.state.score.answered + ' 题 · 对 ' + this.state.score.correct + ' 题'"
            }
          }
        },
        {
          "componentName": "Text",
          "props": {
            "style": "font-size:13px;line-height:1.8;display:block;margin-bottom:10px;",
            "text": { "type": "JSExpression", "value": "this.state.feedback" }
          }
        },
        {
          "componentName": "Text",
          "props": {
            "style": "font-size:15px;font-weight:600;line-height:1.7;display:block;margin-bottom:12px;",
            "text": {
              "type": "JSExpression",
              "value": "this.state.quiz.no + '. [' + this.state.quiz.type + '] ' + this.state.quiz.stem"
            }
          }
        },
        {
          "componentName": "TinyRadioGroup",
          "props": {
            "vertical": true,
            "modelValue": { "type": "JSExpression", "model": true, "value": "this.state.selected" },
            "options": { "type": "JSExpression", "value": "this.state.quiz.options" },
            "onChange": { "type": "JSExpression", "value": "this.pick" }
          }
        },
        {
          "componentName": "Text",
          "props": {
            "style": "font-size:12px;opacity:.55;display:block;margin-top:12px;",
            "text": "点击选项即提交；说「跳过」「提示」「换题型」「退出」都可以。"
          }
        }
      ]
    }
  ]
}
