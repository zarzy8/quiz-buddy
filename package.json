{
  "name": "dsh-skill-quiz-buddy",
  "version": "0.1.1",
  "description": "Quiz Buddy for DeepSeek Harness: turn a document, your own question bank or a review PDF into single-choice, multiple-choice and true/false questions, then quiz you and report your mistakes.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "assets",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "quiz",
    "study"
  ],
  "license": "MIT"
}
